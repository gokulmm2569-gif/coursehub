# CourseHub local development configuration
# Copy to .env locally; never commit real credentials.
MYSQL_DATABASE=coursehub
MYSQL_USER=coursehub_app
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DJANGO_SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
COURSEHUB_API_URL=http://localhost:8001
DJANGO_PORT=8000
FASTAPI_PORT=8001
VITE_API_BASE_URL=http://localhost:8001/api/v1
MEDIA_ROOT=media
